# Oqila AI — Environment Variables
# Copy this file to .env and fill in your actual values

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WEBAPP_URL=https://your-domain.com

# --- App settings ---
# Set to "mock" to always return demo data (for offline/stage presentation)
# Set to "gemini" to use real Gemini API
AI_MODE=gemini

# --- Server ---
HOST=0.0.0.0
PORT=8000
