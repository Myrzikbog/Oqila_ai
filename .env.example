# Oqila AI — Environment Variables
# Copy this file to .env and fill in your actual values

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WEBAPP_URL=https://your-domain.com
# Secret Telegram must send with every webhook update (optional: derived from the bot token if empty)
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user ids that are administrators (they open /admin without a key)
ADMIN_TELEGRAM_IDS=

# --- Security (deploy.sh generates these automatically if empty) ---
# Admin panel key, at least 16 characters. Empty = admin key login disabled.
ADMIN_SECRET_KEY=
# Signs user session tokens. Empty = generated into .session_secret on first start.
SESSION_SECRET=
# Allow browser guests outside Telegram (1) or require opening the app from Telegram (0)
ALLOW_GUEST_LOGIN=1
# New guest accounts one IP address may create per hour (every guest gets its own AI quota). 0 = no limit
GUESTS_PER_IP_PER_HOUR=5
# Addresses of your own reverse proxy: only from them is the X-Real-IP header believed
TRUSTED_PROXIES=127.0.0.1,::1
# Fernet key that encrypts the sellers' Uzum API keys in the database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = a key is generated into .uzum_key on first start (do not lose it, keep it out of DB backups)
UZUM_KEY_ENCRYPTION_KEY=

# --- App settings ---
# Set to "mock" to always return demo data (for offline/stage presentation)
# Set to "gemini" to use real Gemini API
AI_MODE=gemini

# --- Telegram bot username (shown as QR code on the /stage page) ---
TELEGRAM_BOT_USERNAME=oqila_ai_bot

# --- AI usage limits (protect the Gemini quota) ---
AI_CARD_LIMIT_PER_HOUR=20
AI_CARD_LIMIT_PER_DAY=60
AI_LEGAL_LIMIT_PER_HOUR=30
AI_LEGAL_LIMIT_PER_DAY=100
# Real Gemini requests per day for the whole app (one card is up to 7 requests: text, pictures, text checks).
# Above it the AI answers "temporarily unavailable" instead of spending money (0 = unlimited)
AI_GLOBAL_DAILY_LIMIT=1000
# Poster text edits are drawn on the server without AI: this only protects the CPU
POSTER_RENDER_LIMIT_PER_HOUR=400
POSTER_RENDER_LIMIT_PER_DAY=3000

# --- Server ---
HOST=0.0.0.0
PORT=8000

# Text models (optional; defaults are fine). The fallback is tried when the first one fails.
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_TEXT_FALLBACK_MODEL=
# GEMINI_LEGAL_MODEL=
# Timeout of one Gemini request, milliseconds
# GEMINI_TIMEOUT_MS=45000

# Image models (optional; defaults are fine)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image
# GEMINI_VERIFY_MODEL=gemini-2.5-flash
