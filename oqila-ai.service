[Unit]
Description=Oqila AI FastAPI Service (Tadbirkor Qizlar)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/oqila-ai
EnvironmentFile=/var/www/oqila-ai/.env
ExecStart=/var/www/oqila-ai/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
